<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sadiya | AI/ML Portfolio</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', sans-serif;
    }

    body {
      background: radial-gradient(circle at top, #0f172a, #020617);
      color: #e2e8f0;
      overflow-x: hidden;
    }

    /* smooth scroll */
    html {
      scroll-behavior: smooth;
    }

    /* glow animation */
    @keyframes glow {
      0% { box-shadow: 0 0 10px #38bdf8; }
      50% { box-shadow: 0 0 25px #38bdf8; }
      100% { box-shadow: 0 0 10px #38bdf8; }
    }

    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
      100% { transform: translateY(0px); }
    }

    header {
      text-align: center;
      padding: 90px 20px;
      background: linear-gradient(135deg, #0f172a, #1e293b);
      border-bottom: 1px solid #1e293b;
    }

    header h1 {
      font-size: 52px;
      color: #38bdf8;
      text-shadow: 0 0 20px #38bdf8;
      animation: float 4s ease-in-out infinite, glow 3s infinite;
    }

    header p {
      margin-top: 10px;
      color: #94a3b8;
    }

    .container {
      max-width: 1100px;
      margin: auto;
      padding: 40px 20px;
    }

    .card {
      background: rgba(30, 41, 59, 0.85);
      padding: 22px;
      border-radius: 16px;
      margin-bottom: 20px;
      border: 1px solid rgba(56, 189, 248, 0.25);
      box-shadow: 0 0 15px rgba(56, 189, 248, 0.1);
      transform: translateY(40px);
      opacity: 0;
      transition: all 0.8s ease;
      backdrop-filter: blur(10px);
    }

    .card.show {
      transform: translateY(0);
      opacity: 1;
    }

    h2 {
      color: #38bdf8;
      margin-bottom: 10px;
      text-shadow: 0 0 10px #38bdf8;
    }

    ul {
      padding-left: 20px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .tag {
      display: inline-block;
      background: #0f172a;
      border: 1px solid #38bdf8;
      padding: 5px 10px;
      border-radius: 20px;
      margin: 5px;
      font-size: 12px;
      box-shadow: 0 0 10px rgba(56,189,248,0.25);
      transition: 0.3s;
    }

    .tag:hover {
      transform: scale(1.1);
      box-shadow: 0 0 15px #38bdf8;
    }

    a {
      color: #38bdf8;
      text-decoration: none;
    }

    footer {
      text-align: center;
      padding: 30px;
      color: #94a3b8;
      border-top: 1px solid #1e293b;
    }
  </style>
</head>
<body>

<header>
  <h1>Hi, I'm Sadiya 👋</h1>
  <p>AI/ML Enthusiast | CSE Undergraduate | Aspiring Software Engineer</p>
</header>

<div class="container">

  <div class="card">
    <h2>About Me</h2>
    <p>Focused on AI, Machine Learning, and building impactful real-world solutions.</p>
  </div>

  <div class="card">
    <h2>Skills</h2>
    <div>
      <span class="tag">C</span>
      <span class="tag">C++</span>
      <span class="tag">Java</span>
      <span class="tag">JavaScript</span>
      <span class="tag">Python</span>
      <span class="tag">HTML</span>
      <span class="tag">CSS</span>
      <span class="tag">React</span>
      <span class="tag">Node.js</span>
      <span class="tag">MongoDB</span>
      <span class="tag">MySQL</span>
      <span class="tag">AWS Basics</span>
    </div>
  </div>

  <div class="card">
    <h2>Projects</h2>
    <ul>
      <li>Personal Expense Navigator</li>
      <li>Doctor on Call App</li>
      <li>Internet Saver</li>
    </ul>
  </div>

  <div class="grid">
    <div class="card">
      <h2>Current Focus</h2>
      <ul>
        <li>DSA</li>
        <li>Machine Learning</li>
        <li>Open Source</li>
      </ul>
    </div>

    <div class="card">
      <h2>Goals</h2>
      <ul>
        <li>AI/ML Internships</li>
        <li>Open Source Contributions</li>
        <li>Real-world AI Projects</li>
      </ul>
    </div>
  </div>

  <div class="card">
    <h2>Connect With Me</h2>
    <p>🔗 LinkedIn: <a href="https://www.linkedin.com/in/Sadiyaas">Profile</a></p>
    <p>📧 Email: Sadiyasanadi91@gmail.com</p>
  </div>

</div>

<footer>
  ⭐ "Building consistency in AI/ML step by step."
</footer>

<script>
  const cards = document.querySelectorAll('.card');

  const observer = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('show');
      }
    });
  }, { threshold: 0.2 });

  cards.forEach(card => observer.observe(card));
</script>

</body>
</html>
